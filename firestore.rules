rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function bootstrapAdmin() {
      return signedIn() && request.auth.token.email == 'diego906p@gmail.com';
    }
    function isAdmin() {
      return bootstrapAdmin() || exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }
    function isOwner(dni) {
      return signedIn()
        && exists(/databases/$(database)/documents/perfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.dni == dni;
    }
    function isOwnerHistorial(historialId) {
      return signedIn()
        && exists(/databases/$(database)/documents/perfiles/$(request.auth.uid))
        && historialId.matches('^' + get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.dni + '_[A-Za-z0-9_-]+$');
    }

    // El primer administrador debe usar el correo de bootstrap. Después de
    // crear su perfil se registra también en /administradores/{uid}.
    match /administradores/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if (bootstrapAdmin() && uid == request.auth.uid)
        || (isAdmin() && request.resource.data.uid == uid);
      allow update, delete: if isAdmin();
    }

    match /usuarios/{dni} {
      allow get: if isAdmin() || isOwner(dni);
      allow list: if isAdmin();
      allow create: if isAdmin() || (bootstrapAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rol == 'ADMIN');
      // En el primer acceso el propio trabajador solo puede confirmar que
      // reemplazó la contraseña inicial. No puede modificar su perfil ni
      // reactivar esta marca después.
      allow update: if isAdmin() || (isOwner(dni)
        && resource.data.debeCambiarPassword == true
        && request.resource.data.debeCambiarPassword == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['debeCambiarPassword']));
      allow delete: if isAdmin();
    }

    // Índice privado para restaurar la sesión desde Firebase Auth sin
    // abrir consultas sobre todos los DNI/correos de la empresa.
    match /perfiles/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || (bootstrapAdmin() && uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /modulos/{moduloId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /asignaciones/{asignacionId} {
      allow read: if isAdmin() || isOwner(resource.data.usuarioId);
      allow create, update, delete: if isAdmin();
    }

    match /historial/{historialId} {
      // Al iniciar por primera vez el documento aún no existe. En ese caso
      // no hay resource.data para autorizar el get, por lo que se valida el
      // prefijo DNI del ID determinista "dni_modulo".
      allow get: if isAdmin() || isOwnerHistorial(historialId);
      allow list: if isAdmin() || isOwner(resource.data.usuarioId);
      allow create: if isOwner(request.resource.data.usuarioId)
        && request.resource.data.estado == 'EN_PROGRESO';
      allow update: if isOwner(resource.data.usuarioId)
        && request.resource.data.usuarioId == resource.data.usuarioId;
      allow delete: if isAdmin();
    }

    match /configuracion/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
